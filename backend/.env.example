APP_NAME=Habit Hero API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./habit_hero.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_AVATAR_BYTES=2097152
UPLOADS_URL_PREFIX=/uploads
NOTIFICATIONS_SCHEDULER_ENABLED=false
NOTIFICATIONS_SCHEDULER_INTERVAL_SECONDS=900
# Google Gemini (backend-only; never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90

# Google Calendar OAuth (backend-only; never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/google/callback
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
FRONTEND_APP_URL=http://127.0.0.1:5173
